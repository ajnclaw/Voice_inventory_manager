# Copy this to .env and fill in real values. Never commit the real .env.

LLM_PROVIDER=openrouter
OPENROUTER_API=

# Override the model if you want something other than the provider's
# default (openai/gpt-4o-mini for openrouter).
# LLM_MODEL=openai/gpt-4o-mini

# Required -- agent_server.py refuses to start without this. The one
# shared secret the phone app sends as `Authorization: Bearer <token>`
# on every request. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=
