# Copy this to .env and fill in real values. Never commit the real .env.

LLM_PROVIDER=openrouter
OPENROUTER_API=

# Override the model if you want something other than the provider's
# default (openai/gpt-4o-mini for openrouter).
# LLM_MODEL=openai/gpt-4o-mini

# Required -- agent_server.py refuses to start without this. The one
# shared secret the phone app sends as `Authorization: Bearer <token>`
# on every request. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=

# Google sign-in for the web UI. The server fails closed unless all three
# of these are set.
#   GOOGLE_CLIENT_ID: OAuth "Web application" client ID from Google Cloud
#   ALLOWED_GOOGLE_EMAILS: comma-separated emails allowed to sign in
#   SESSION_SECRET: long random string used to sign the session cookie
GOOGLE_CLIENT_ID=
ALLOWED_GOOGLE_EMAILS=
SESSION_SECRET=
# SESSION_TTL_DAYS=30

# Bind address. Use 127.0.0.1 when running behind Caddy/nginx.
# AGENT_HOST=0.0.0.0

# Alternative providers (set LLM_PROVIDER to gemini, deepseek, ollama, ...)
# GEMINI_API_KEY=
